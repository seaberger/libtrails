---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBar from '../../components/SearchBar.astro';
import { getDomains, getCoverUrl } from '../../lib/api';
import { url } from '../../lib/url';

const domains = await getDomains();
---

<BaseLayout title="Themes" description="Browse your library by broad themes">
  <header class="mb-6">
    <h1 class="text-2xl font-medium text-[var(--color-text)] mb-2">
      Themes
    </h1>
    <p class="text-[var(--color-text-muted)]">
      Explore {domains.length} broad themes across your library
    </p>
  </header>

  <SearchBar placeholder="Search themes..." scope="domains" />

  <div class="flex flex-col md:flex-row gap-6" id="domain-browser">
    <!-- Domain selector: horizontal scroll on mobile, vertical list on desktop -->
    <div class="w-full md:w-64 md:flex-shrink-0">
      <!-- Mobile: wrapping chip layout with show more -->
      <div class="flex md:hidden flex-wrap gap-1.5 pb-3" id="mobile-chips">
        {domains.map((domain, index) => (
          <button
            class:list={[
              "domain-item px-2.5 py-1 rounded-full text-xs font-medium transition-all duration-200 border whitespace-nowrap data-[selected]:bg-[var(--color-accent)] data-[selected]:text-white data-[selected]:border-[var(--color-accent)] bg-[var(--color-surface)] text-[var(--color-text)] border-[var(--color-border)]",
              index >= 8 && "mobile-chip-overflow hidden"
            ]}
            data-domain-id={domain.domain_id}
            data-selected={index === 0 ? "true" : undefined}
          >
            {domain.label}
          </button>
        ))}
        {domains.length > 8 && (
          <button
            id="mobile-chips-toggle"
            class="px-2.5 py-1 rounded-full text-xs font-medium border border-[var(--color-border)] text-[var(--color-accent)] bg-transparent transition-colors hover:bg-[var(--color-surface)]"
          >
            +{domains.length - 8} more
          </button>
        )}
      </div>
      <!-- Desktop: vertical list -->
      <div class="hidden md:block sticky top-24 space-y-1">
        {domains.map((domain, index) => (
          <button
            class="domain-item w-full text-left px-4 py-3 rounded-lg transition-all duration-200 hover:bg-[var(--color-surface)] border border-transparent data-[selected]:bg-[var(--color-surface)] data-[selected]:border-[var(--color-accent)]"
            data-domain-id={domain.domain_id}
            data-selected={index === 0 ? "true" : undefined}
          >
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium text-[var(--color-text)]">
                {domain.label}
              </span>
              <span class="text-xs text-[var(--color-text-muted)] bg-[var(--color-bg)] px-2 py-0.5 rounded-full">
                {domain.community_count || domain.cluster_count}
              </span>
            </div>
          </button>
        ))}
      </div>
    </div>

    <!-- Right panel: Domain detail -->
    <div class="flex-1 min-w-0 md:sticky md:top-24 md:self-start md:max-h-[calc(100vh-7rem)] md:overflow-y-auto">
      {domains.map((domain, index) => (
        <div
          class="domain-detail"
          data-domain-id={domain.domain_id}
          style={index === 0 ? "" : "display: none;"}
        >
          <div class="bg-[var(--color-surface)] rounded-lg p-6 border border-[var(--color-border)]">
            <h2 class="text-xl font-semibold text-[var(--color-text)] mb-2">
              {domain.label}
            </h2>
            <p class="text-sm text-[var(--color-text-muted)] mb-6">
              {domain.community_count || domain.cluster_count} topics · {domain.primary_book_count} primary books · {domain.book_count} related
            </p>

            <!-- Top topics -->
            <div class="mb-6">
              <h3 class="text-sm font-medium text-[var(--color-text)] mb-3">Top Topics</h3>
              <div class="flex flex-wrap gap-2">
                {(domain.top_communities?.length ? domain.top_communities : domain.top_clusters).slice(0, 8).map((item: any) => (
                  <a
                    href={url(`/communities/${item.community_id ?? item.cluster_id}`)}
                    class="px-3 py-1.5 bg-[var(--color-bg)] text-sm text-[var(--color-text)] rounded-full hover:bg-[var(--color-accent)] hover:text-white transition-colors"
                  >
                    {item.label}
                  </a>
                ))}
              </div>
            </div>

            <!-- Sample books -->
            <div>
              <h3 class="text-sm font-medium text-[var(--color-text)] mb-3">Featured Books</h3>
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
                {domain.sample_books.slice(0, 5).map((book: any) => (
                  <a href={url(`/books/${book.id}`)} class="group">
                    <div class="aspect-[2/3] bg-[var(--color-bg)] rounded overflow-hidden mb-2">
                      <img
                        src={getCoverUrl(book.calibre_id)}
                        alt={book.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                      />
                    </div>
                    <p class="text-xs text-[var(--color-text)] line-clamp-2 group-hover:text-[var(--color-accent)] transition-colors">
                      {book.title}
                    </p>
                  </a>
                ))}
              </div>
            </div>

            <!-- View all topics link -->
            <div class="mt-6 pt-4 border-t border-[var(--color-border)]">
              <a
                href={url(`/communities?domain=${domain.domain_id}`)}
                class="text-sm text-[var(--color-accent)] hover:underline"
              >
                View all {domain.community_count || domain.cluster_count} topics in {domain.label} →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  function initDomainBrowser() {
    const items = document.querySelectorAll('.domain-item');
    const details = document.querySelectorAll('.domain-detail');

    items.forEach(item => {
      item.addEventListener('click', () => {
        const domainId = item.getAttribute('data-domain-id');

        // Update selected state on ALL domain items (both mobile chips and desktop list)
        items.forEach(i => {
          if (i.getAttribute('data-domain-id') === domainId) {
            i.setAttribute('data-selected', 'true');
          } else {
            i.removeAttribute('data-selected');
          }
        });

        // Show corresponding detail
        details.forEach(d => {
          if (d.getAttribute('data-domain-id') === domainId) {
            (d as HTMLElement).style.display = '';
          } else {
            (d as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  // Mobile chips show more/less toggle
  function initChipsToggle() {
    const toggle = document.getElementById('mobile-chips-toggle');
    if (!toggle) return;
    const overflowChips = document.querySelectorAll('.mobile-chip-overflow');
    let expanded = false;
    toggle.addEventListener('click', () => {
      expanded = !expanded;
      overflowChips.forEach(chip => chip.classList.toggle('hidden', !expanded));
      toggle.textContent = expanded ? 'Show less' : `+${overflowChips.length} more`;
    });
  }

  function initThemeSearch() {
    const items = document.querySelectorAll('.domain-item');
    const details = document.querySelectorAll('.domain-detail');
    const browser = document.getElementById('domain-browser');
    if (!browser) return;
    if ((browser as HTMLElement).dataset.searchInit === 'true') return;
    (browser as HTMLElement).dataset.searchInit = 'true';

    document.addEventListener('libtrails:search', ((e: CustomEvent) => {
      if (e.detail.scope !== 'domains') return;
      const { data } = e.detail;
      const matchingIds = new Set(data.domains.map((d: any) => String(d.domain_id)));

      if (matchingIds.size === 0) {
        // Hide all
        items.forEach(i => (i as HTMLElement).style.opacity = '0.3');
        details.forEach(d => (d as HTMLElement).style.display = 'none');
        return;
      }

      // Dim non-matching domains, highlight matching ones
      items.forEach(item => {
        const domainId = item.getAttribute('data-domain-id');
        if (matchingIds.has(domainId!)) {
          (item as HTMLElement).style.opacity = '1';
        } else {
          (item as HTMLElement).style.opacity = '0.3';
        }
      });

      // Auto-select top matching domain
      const topDomainId = String(data.domains[0].domain_id);
      items.forEach(i => {
        if (i.getAttribute('data-domain-id') === topDomainId) {
          i.setAttribute('data-selected', 'true');
        } else {
          i.removeAttribute('data-selected');
        }
      });
      details.forEach(d => {
        (d as HTMLElement).style.display = d.getAttribute('data-domain-id') === topDomainId ? '' : 'none';
      });
    }) as EventListener);

    document.addEventListener('libtrails:search-clear', ((e: CustomEvent) => {
      if (e.detail.scope !== 'domains') return;
      // Restore all domains to full opacity
      items.forEach(i => (i as HTMLElement).style.opacity = '1');
      // Re-select first domain
      const firstId = items[0]?.getAttribute('data-domain-id');
      if (firstId) {
        items.forEach(i => {
          if (i.getAttribute('data-domain-id') === firstId) {
            i.setAttribute('data-selected', 'true');
          } else {
            i.removeAttribute('data-selected');
          }
        });
        details.forEach(d => {
          (d as HTMLElement).style.display = d.getAttribute('data-domain-id') === firstId ? '' : 'none';
        });
      }
    }) as EventListener);
  }

  initDomainBrowser();
  initChipsToggle();
  initThemeSearch();
  document.addEventListener('astro:page-load', () => {
    initDomainBrowser();
    initChipsToggle();
    initThemeSearch();
  });
</script>
