---
// Server-rendered dynamic route
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import TopicChip from '../../components/TopicChip.astro';
import { getCommunity } from '../../lib/api';
import { url } from '../../lib/url';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect(url('/'));
}

const communityId = parseInt(id, 10);

let community;
try {
  community = await getCommunity(communityId);
} catch (e) {
  return Astro.redirect(url('/'));
}
---

<BaseLayout title={community.label} description={`Browse ${community.books.length} books in the "${community.label}" topic`}>
  <header class="mb-8">
    <nav class="text-sm text-[var(--color-text-muted)] mb-4">
      <a href={url("/communities")} class="hover:text-[var(--color-text)] transition-colors">Topics</a>
      <span class="mx-2">/</span>
      <span class="text-[var(--color-text)]">{community.label}</span>
    </nav>

    <h1 class="text-2xl font-medium text-[var(--color-text)] mb-2">
      {community.label}
    </h1>
    <p class="text-[var(--color-text-muted)] mb-4">
      {community.books.length} books · {community.topic_count} topics · {community.clusters.length} clusters
      {community.domain_label && (
        <span> · <span class="text-[var(--color-accent)]">{community.domain_label}</span></span>
      )}
    </p>

    <!-- Constituent clusters -->
    {community.clusters.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {community.clusters.slice(0, 12).map(cluster => (
          <span class="px-3 py-1.5 bg-[var(--color-bg)] text-sm text-[var(--color-text)] rounded-full">
            {cluster.label}
            <span class="text-[var(--color-text-muted)] ml-1">({cluster.size})</span>
          </span>
        ))}
      </div>
    )}
  </header>

  <div class="space-y-3">
    {community.books.map(book => (
      <BookCard book={book} />
    ))}
  </div>
</BaseLayout>
